{
  "name": "@meapp/server",
  "scripts": {
    "dev": "bun --watch --hot src/index.ts",
    "start": "bun src/index.ts",
    "migrate": "bun run src/migrate.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format .",
    "format:fix": "bunx @biomejs/biome format --write ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "@meapp/db": "workspace:*",
    "@meapp/shared": "workspace:*",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.9",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=24.3.0",
    "bun": ">=1.4"
  },
  "type": "module",
  "main": "server.ts"
}
