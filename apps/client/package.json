{
  "name": "client",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env APP_VARIANT=development expo start",
    "start": "cross-env APP_VARIANT=development expo start",
    "export:web": "cross-env APP_VARIANT=production expo export -p web",
    "build:android:dev": "cross-env APP_VARIANT=development eas build --platform android --profile development --local",
    "build:android:prev": "cross-env APP_VARIANT=preview eas build --platform android --profile preview --local",
    "build:android:prod": "cross-env APP_VARIANT=production eas build --platform android --profile production --local",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format .",
    "format:fix": "bunx @biomejs/biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "echo \"No client tests defined yet\""
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@meapp/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.103.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-ebf51a3-20250411",
    "cross-env": "^10.1.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-compiler-runtime": "^19.0.0-beta-ebf51a3-20250411",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.13.6",
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3"
  },
  "private": true,
  "type": "module",
  "contributors": [
    {
      "name": "Emil Knysak"
    },
    {
      "name": "Dawid Kozłowski"
    }
  ]
