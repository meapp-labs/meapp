#!/bin/sh
set -e

# 1. Format and lint staged files with Biome
bunx @biomejs/biome check --write --no-errors-on-unmatched --staged
git update-index --again 2>/dev/null || git add -u

# 2. Identify staged files to determine applicable checks
STAGED_FILES=$(git diff --cached --name-only)

DB_CHANGED=false
SHARED_CHANGED=false
SERVER_CHANGED=false
CLIENT_CHANGED=false

if echo "$STAGED_FILES" | grep -E '^packages/db/' >/dev/null 2>&1; then
  DB_CHANGED=true
fi

if echo "$STAGED_FILES" | grep -E '^packages/shared/' >/dev/null 2>&1; then
  SHARED_CHANGED=true
fi

if echo "$STAGED_FILES" | grep -E '^(apps/server/|packages/db/|packages/shared/)' >/dev/null 2>&1; then
  SERVER_CHANGED=true
fi

if echo "$STAGED_FILES" | grep -E '^(apps/client/|packages/shared/)' >/dev/null 2>&1; then
  CLIENT_CHANGED=true
fi

# 3. Run typechecks conditionally. Only the *changed* workspace is checked —
#    previously every commit touching apps/server ran the full server test
#    suite, which made commits slow. Tests still run in CI on every push.
#    For fast local test runs: bun run test:server
run_typecheck() {
  echo "==> typecheck:$1"
  bun run "typecheck:$1"
}

if [ "$DB_CHANGED" = true ]; then
  run_typecheck db
fi

if [ "$SHARED_CHANGED" = true ]; then
  run_typecheck shared
fi

if [ "$SERVER_CHANGED" = true ]; then
  run_typecheck server
  # Server tests only when server source itself changed (not for db/shared)
  if echo "$STAGED_FILES" | grep -E '^apps/server/' >/dev/null 2>&1; then
    echo "==> test:server"
    bun run test:server
  fi
fi

if [ "$CLIENT_CHANGED" = true ]; then
  run_typecheck client
fi
