    ports: ["127.0.0.1:6379:6379"]
    volumes: ["meapp-redis-data:/data:Z"]
    restart: unless-stopped
    networks: [meapp-net]

  server:
    # To rebuild: podman build --no-cache -f Containerfile -t meapp-server-dev .
    image: localhost/meapp-server-dev:latest
    container_name: meapp-server-dev
    ports: ["127.0.0.1:3000:3000"] # FIX #7 - loopback only, Caddy fronts it
    volumes:
      - ./apps/server:/app/apps/server:z
      - ./packages/db/src:/app/packages/db/src:z
      - ./packages/shared/src:/app/packages/shared/src:z
      - ./package.json:/app/package.json:ro,z
      - ./bun.lock:/app/bun.lock:ro,z
      - meapp-server-node-modules:/app/node_modules:Z
      - meapp-server-data:/app/data:Z # FIX #5 - persistent SQLite
    env_file: apps/server/.env.local
    environment:
      - NODE_ENV=development
      - DATABASE_URL=/app/data/data.db # FIX #6 - matches volume
      - REDIS_URL=redis://redis:6379
    depends_on: [redis]
    command: ["bun", "--watch", "apps/server/src/index.ts"]
    restart: unless-stopped
    networks: [meapp-net]

networks:
  meapp-net:
    driver: bridge

volumes:
  meapp-redis-data:
  meapp-server-data: # FIX #5
  meapp-server-node-modules:
