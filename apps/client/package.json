{
  "name": "@meapp/client",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "dev": "cross-env APP_VARIANT=development expo start",
    "web": "cross-env APP_VARIANT=development expo start --web",
    "start": "cross-env APP_VARIANT=development expo start",
    "export:web": "cross-env APP_VARIANT=production expo export -p web",
    "build:android:dev": "cross-env APP_VARIANT=development eas build --platform android --profile development --local",
    "build:android:prev": "cross-env APP_VARIANT=preview eas build --platform android --profile preview --local",
    "build:android:prod": "cross-env APP_VARIANT=production eas build --platform android --profile production --local",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check --write .",
    "format": "bunx @biomejs/biome format .",
    "format:fix": "bunx @biomejs/biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@meapp/shared": "workspace:*",
    "@open-e2ee/signal-protocol-sdk": "6.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.43",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.103.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.1",
    "expo": "~55.0.27",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.16",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.15",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.17",
    "expo-system-ui": "~55.0.22",
    "idb": "^8.0.3",
    "react": "19.2.0",
    "react-compiler-runtime": "^19.0.0-beta-ebf51a3-20250411",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.3"
  },
  "private": true,
