{
  "name": "meapp",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "trustedDependencies": ["expo", "expo-modules-autolinking"],
  "devDependencies": {
    "@biomejs/biome": "^1.9.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "podman compose -f compose.dev.yaml up -d && podman compose -f compose.dev.yaml logs -f",
    "dev:server": "bun --filter @meapp/server dev",
    "dev:client": "bun --filter @meapp/client dev",
    "dev:web": "bun --filter @meapp/client web",
    "start:server": "bun --filter @meapp/server start",
    "lint": "bunx @biomejs/biome check",
    "lint:fix": "bunx @biomejs/biome check --write",
    "lint:server": "bun --filter @meapp/server lint",
    "lint:client": "bun --filter @meapp/client lint",
    "format": "bunx @biomejs/biome format",
    "format:fix": "bunx @biomejs/biome format --write",
    "format:server": "bun --filter @meapp/server format",
    "format:client": "bun --filter @meapp/client format",
    "typecheck": "bun run typecheck:server && bun run typecheck:client && bun run typecheck:db && bun run typecheck:shared",
    "typecheck:server": "bun --filter @meapp/server typecheck",
    "typecheck:client": "bun --filter @meapp/client typecheck",
    "typecheck:db": "bun --filter @meapp/db typecheck",
    "typecheck:shared": "bun --filter @meapp/shared typecheck",
    "test": "bun run test:server && bun run test:client",
    "test:server": "bun --filter @meapp/server test",
    "test:server:watch": "bun --filter @meapp/server test:watch",
    "test:client": "bun --filter @meapp/client test",
    "db:generate": "bun --filter @meapp/db db:generate",
    "db:migrate": "bun --filter @meapp/server migrate",
    "db:push": "bun --filter @meapp/db db:push",
    "db:studio": "bun --filter @meapp/db db:studio",
    "build:web": "bun --filter @meapp/client export:web",
    "build:android:dev": "bun --filter @meapp/client build:android:dev",
    "build:android:prev": "bun --filter @meapp/client build:android:prev",
    "build:android:prod": "bun --filter @meapp/client build:android:prod"
  },
  "overrides": { "typescript": "^5.8.3" }
}
