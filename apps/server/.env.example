# ==============================================================================
# MeApp Server Environment (single source of truth)
# Copy to apps/server/.env.local for local dev. Prod compose sets these via
# compose.prod.yaml environment (MEAPP_* passthroughs).
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Comma-separated list of allowed CORS/cookie origins in production
DOMAIN=

DATABASE_URL=./data/data.db
REDIS_URL=redis://127.0.0.1:6379

# Auth secrets - REQUIRED, no dev fallback in production
JWT_SECRET=dev-secret-change-me-in-production
WS_TICKET_SECRET=dev-ws-ticket-secret-change-me

# WebSocket limits (see apps/server/src/lib/config.ts)
MAX_UNAUTH_GLOBAL=100
MAX_UNAUTH_PER_IP=10
MAX_WS_CONNS_PER_USER=3
MAX_ROOM_SUBS_PER_USER=10
UNAUTH_TIMEOUT_MS=2000

# End-to-end encryption (Signal protocol relay) - false disables the /api/e2e surface
E2E_ENABLED=true

# Encrypted media. Set all five values to enable uploads. R2_PUBLIC_URL must
# be a custom-domain HTTPS origin; configure bucket CORS for browser PUTs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
MEDIA_USER_QUOTA_BYTES=2147483648
# 0 keeps linked media indefinitely; positive values expire after linkage.
MEDIA_LINKED_TTL_SECONDS=0
# Optional self-hosted adapter (separate loopback object server: bun run media:local).
MEDIA_STORAGE=r2
# Local mode requires an absolute path and public origin. Back up this directory
# separately from SQLite. HTTPS required in production, loopback HTTP allowed in dev.
# MEDIA_LOCAL_DIRECTORY=D:/meapp/apps/server/data/media
# MEDIA_LOCAL_PUBLIC_URL=http://127.0.0.1:3001
MEDIA_LOCAL_PORT=3001

# Client Configuration (Expo) - consumed by the app bundle
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
